# Copy to your process manager / shell. Never commit real values.
PORT=3000
NODE_ENV=production
# REQUIRED in production: long random string. Encrypts users' Gemini keys at rest.
# Changing it makes stored keys undecryptable (users must re-enter them).
APP_SECRET=
# Where the SQLite DB and uploaded files live (back this directory up).
DATA_DIR=./server/data
# Models (verify current names in Google AI Studio docs)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# 1 = offline mock (no Google calls) for demos/tests
GEMINI_MOCK=0

# Public URL of the app — used in emailed links (reset, invitations). REQUIRED in production.
APP_URL=https://ads.example.com
# Real email delivery (required in production). Example: smtp://user:pass@smtp.office365.com:587
SMTP_URL=
MAIL_FROM=Ad Studio <no-reply@example.com>
# Set only behind a reverse proxy (IIS/nginx/Cloudflare Tunnel): number of trusted hops.
TRUST_PROXY=
# Default monthly quotas per organization (platform admins can override per org)
QUOTA_TEXT_MONTHLY=300
QUOTA_IMAGE_MONTHLY=200
# Emails allowed to set org quotas (comma separated)
PLATFORM_ADMINS=
